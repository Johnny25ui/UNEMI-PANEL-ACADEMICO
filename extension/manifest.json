{
  "manifest_version": 3,
  "name": "UNEMI Panel Sync",
  "version": "1.3.2",
  "description": "Sincroniza actividades del Aula Virtual UNEMI, limpia materias y evita duplicados por variantes de URL.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://aulagradob.unemi.edu.ec/*",
    "https://unemi-panel-academico.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://aulagradob.unemi.edu.ec/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
